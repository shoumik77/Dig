# Identifies Dig to MusicBrainz (required by their API policy). Include a contact URL or email.
MUSICBRAINZ_USER_AGENT="Dig/0.2.0 (https://github.com/shoumik77/Dig)"
# TTL for cached MusicBrainz responses, in ms (default 600000 = 10 min)
MUSICBRAINZ_CACHE_TTL_MS=600000

# Optional — Discogs enrichment of selected nodes (cover art, genres,
# credits, videos, have/want). Create a token at
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
# UA sent to Discogs (their API policy requires a unique identifier)
DISCOGS_USER_AGENT="Dig/0.2.0 +https://github.com/shoumik77/Dig"
# TTL for cached Discogs responses, in ms (default 3600000 = 1 h)
DISCOGS_CACHE_TTL_MS=3600000

# SQLite file for Saved Crates (default .data/crates.db)
CRATES_DB_PATH=
